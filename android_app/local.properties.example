# Template for machine-specific build settings.
# Copy this file to android_app/local.properties and adjust the paths.
# local.properties is gitignored and must NEVER be committed.
# All keys are optional - the build falls back to environment variables
# and well-known locations when a key is unset.

# Android SDK location (usually generated automatically by Android Studio).
# sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk

# Directory containing the cargo executable.
# Fallbacks: CARGO_HOME env var -> ~/.cargo/bin -> PATH.
# cargo.dir=C\:\\Users\\you\\.cargo\\bin

# NDK directory used to link the Rust core.
# Fallbacks: ANDROID_NDK_HOME env var -> newest NDK under sdk.dir/ndk/.
# rust.ndk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk\\ndk\\30.0.16248370
# supabase.url=https://yourproject.supabase.co
# supabase.anonKey=your-anon-key